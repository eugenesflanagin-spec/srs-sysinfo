// mem_copy.comp - SRS GPU benchmark: VRAM copy bandwidth (shader copy, 16 bytes per load/store).
#version 450
layout(local_size_x = 64) in;
layout(push_constant) uniform PC { uint n4, u1, u2, u3, u4, u5, u6, u7; } pc;
layout(std430, binding = 0) readonly buffer Src { uvec4 s[]; };
layout(std430, binding = 1) writeonly buffer Dst { uvec4 d[]; };

void main()
{
    uint stride = gl_NumWorkGroups.x * 64u;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n4; i += stride) d[i] = s[i];
}
