// mem_read.comp - SRS GPU benchmark: VRAM read bandwidth.
// Grid-stride loop, 16 bytes (uvec4) per load; each invocation writes the 32-bit wrapping sum of
// what it read. The host adds the partial sums (order does not matter mod 2^32) and compares them
// with the sum of the pattern mem_write.comp stored - which checks the write and copy tests too.
#version 450
layout(local_size_x = 64) in;
layout(push_constant) uniform PC { uint n4, u1, u2, u3, u4, u5, u6, u7; } pc;
layout(std430, binding = 0) readonly buffer Src { uvec4 s[]; };
layout(std430, binding = 1) writeonly buffer Part { uint p[]; };

void main()
{
    uint stride = gl_NumWorkGroups.x * 64u;
    uvec4 acc = uvec4(0u);
    for (uint i = gl_GlobalInvocationID.x; i < pc.n4; i += stride) acc += s[i];
    p[gl_GlobalInvocationID.x] = acc.x + acc.y + acc.z + acc.w;
}
